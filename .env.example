# ==============================================================================
# RelayEV Cloud Environment Variables Template
# Copy to .env for local Docker Compose or cloud production deployments
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cryptographic Security & Escrow Settings
# ------------------------------------------------------------------------------
SECRET_KEY=relay_ev_hardware_master_secret_2026
ALGORITHM=HS256
ESCROW_TOKEN_EXPIRE_MINUTES=120

# ------------------------------------------------------------------------------
# 2. Database Configuration
# Zero-Config Mode: Leave DATABASE_URL blank to automatically use SQLite WAL mode.
# Cloud Postgres Mode: postgresql://user:password@host:5432/relayev
# ------------------------------------------------------------------------------
DATABASE_URL=
DATABASE_PATH=relay_ev.db

# ------------------------------------------------------------------------------
# 3. Supabase Cloud Configuration (Optional)
# Fill if syncing with Supabase managed PostgreSQL & Row Level Security
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 4. Networking & CORS
# ------------------------------------------------------------------------------
PORT=8000
HTTP_PORT=80
ALLOWED_ORIGINS=*
NEXT_PUBLIC_API_URL=/api

# ------------------------------------------------------------------------------
# 5. Self-Hosted PostgreSQL Credentials (When using docker compose --profile with-postgres)
# ------------------------------------------------------------------------------
POSTGRES_DB=relayev
POSTGRES_USER=relayev_admin
POSTGRES_PASSWORD=relayev_master_pw_2026
